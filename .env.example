# Exemple de variables d'environnement pour la production.
# Copier vers .env et adapter (ne pas commiter .env).

# Obligatoire en production : clé secrète forte et unique
DJANGO_SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire

# OAuth Google. Ne jamais commiter les vraies valeurs.
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret

# E-mail SMTP (requis pour envoyer les liens de réinitialisation en production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=lockogrand@gmail.com
EMAIL_HOST_PASSWORD=ieqgdbvrzxgqzrxf
DEFAULT_FROM_EMAIL=noreply@example.com

# Désactiver le mode debug en production
DJANGO_DEBUG=False

# Liste des domaines autorisés, séparés par des virgules
ALLOWED_HOSTS=http://127.0.0.1:8000/,localhost:8000

# Optionnel : base de données (à configurer dans settings.py si besoin)
# DB_NAME=nzo_db
# DB_USER=...
# DB_PASSWORD=...
# DB_HOST=localhost
# DB_PORT=3306
